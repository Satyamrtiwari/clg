# Application Config
PROJECT_NAME="Campus Smart Canteen POS"
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://canteen_user:canteen_password@localhost:5432/canteen_db

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]
